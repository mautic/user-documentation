COPY --from=project --chmod=644 docs/requirements.txt /tmp/requirements.txt
RUN install -d -o "$username" /opt/sphinx \
    && runuser -u "$username" -- python3 -m venv /opt/sphinx \
    && runuser -u "$username" -- /opt/sphinx/bin/pip install --no-cache-dir -r /tmp/requirements.txt \
    && echo 'export PATH="/opt/sphinx/bin:$PATH"' > /etc/bashrc/sphinx.bashrc

# Keep in sync with the Vale version in .github/workflows/linting.yml
ARG VALE_VERSION=3.7.1
RUN case "${TARGETARCH}" in arm64) arch=arm64 ;; *) arch=64-bit ;; esac \
    && curl -fsSL "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_${arch}.tar.gz" \
    | tar -xz --no-same-owner -C /usr/local/bin vale \
    && chmod 755 /usr/local/bin/vale
